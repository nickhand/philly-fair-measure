{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "philly-fair-measure",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-08-11",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  },
  "env": {
    "staging": {
      "name": "philly-fair-measure-staging",
      "workers_dev": true,
      "vars": {
        "INDEXABLE": "false"
      }
    },
    "production": {
      "name": "philly-fair-measure-production",
      "workers_dev": false,
      "routes": [
        {
          "pattern": "www.nickhand.dev/fair-measure/*",
          "zone_name": "nickhand.dev"
        }
      ],
      "vars": {
        "INDEXABLE": "true"
      }
    }
  }
}
